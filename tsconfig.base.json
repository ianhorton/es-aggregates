{
    "compilerOptions": {
      "target": "ES2017",
      "lib": ["ES2017"],
      "module": "CommonJS",
      "strictPropertyInitialization": false,
      "declaration": true,
      "composite": true,
      "esModuleInterop": true,
      "strict": true,
      "noImplicitReturns": true,
      "skipLibCheck": true,
      // "noUnusedLocals": true,
      // "noUnusedParameters": true,
      "forceConsistentCasingInFileNames": true,
    },
  }