{
  "name": "@es-aggregates/cosmos",
  "version": "0.0.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "license": "MIT",
  "scripts": {
    "prepare": "yarn build",
    "build": "run-s clean build:tsc",
    "build:tsc": "tsc -b",
    "clean": "rimraf dist coverage tsconfig.tsbuildinfo",
    "emulator": "docker run -d --rm --name es-cosmos-emulator -p 8081:8081 mcr.microsoft.com/cosmosdb/linux/azure-cosmos-emulator:vnext-latest",
    "test": "jest --runInBand --detectOpenHandles --forceExit",
    "preversion": "yarn test",
    "postversion": "echo \"Version updated to $npm_package_version\""
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ianhorton/es-aggregates.git",
    "directory": "packages/cosmos"
  },
  "bugs": {
    "url": "https://github.com/ianhorton/es-aggregates/issues"
  },
  "homepage": "https://github.com/ianhorton/es-aggregates#readme",
  "peerDependencies": {
    "@azure/cosmos": "^4.5.0",
    "@es-aggregates/core": "^2.0.0"
  },
  "devDependencies": {
    "@azure/cosmos": "^4.10.2",
    "@es-aggregates/core": "*",
    "@es-aggregates/store-tests": "*",
    "uuid": "^8.3.2"
  }
}
