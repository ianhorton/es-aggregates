{
  "name": "es-aggregates-monorepo",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "prepare": "yarn build",
    "build": "run-s clean build:tsc",
    "build:tsc": "tsc -b",
    "clean": "rimraf packages/*/dist packages/*/coverage packages/*/tsconfig.tsbuildinfo",
    "pretest": "yarn build:tsc",
    "test": "yarn workspaces run test"
  },
  "devDependencies": {
    "@shelf/jest-dynamodb": "^3.4.4",
    "@types/aws-lambda": "^8.10.131",
    "@types/jest": "30.0.0",
    "@types/uuid": "^8.3.3",
    "jest": "30.5.2",
    "npm-run-all": "^4.1.5",
    "rimraf": "^3.0.0",
    "ts-jest": "29.4.15",
    "typescript": "^4.5.3"
  }
}
